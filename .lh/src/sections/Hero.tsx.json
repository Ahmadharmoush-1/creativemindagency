            "date": 1791647042597,
            "name": "Commit-0",
            "content": "import { useRef } from 'react'\r\nimport { useLang } from '../lib/i18n'\r\nimport { gsap, prefersReduced, useGsap, useMedia } from '../lib/gsap'\r\nimport { useReady } from '../lib/ready'\r\nimport { ui } from '../content/ui'\r\nimport { Cta } from '../components/Brand'\r\n\r\nexport function Hero() {\r\n  const { tr, lang } = useLang()\r\n  const ready = useReady()\r\n  const root = useRef<HTMLElement>(null)\r\n  const desktop = useMedia('(min-width: 1024px)')\r\n  const lines = ui.hero.lines[lang]\r\n\r\n  // Entrance: environment, then depth, then the headline line by line, then the actions.\r\n  useGsap(\r\n    root,\r\n    () => {\r\n      if (prefersReduced()) return\r\n      gsap.set('.hero-media', { opacity: 0, scale: 1.14 })\r\n      gsap.set('.hero-line', { yPercent: 115 })\r\n      gsap.set('.hero-fade', { opacity: 0, y: 26 })\r\n      if (!ready) return\r\n      gsap\r\n        .timeline({ defaults: { ease: 'expo.out' } })\r\n        .to('.hero-media', { opacity: 1, duration: 1.6, ease: 'power2.out' }, 0)\r\n        .to('.hero-media', { scale: 1, duration: 2.6 }, 0)\r\n        .to('.hero-line', { yPercent: 0, duration: 1.3, stagger: 0.12 }, 0.45)\r\n        .to('.hero-fade', { opacity: 1, y: 0, duration: 1, stagger: 0.1 }, 1.05)\r\n    },\r\n    [ready],\r\n  )\r\n\r\n  // Scroll: the camera pushes toward the summit while the headline lifts away.\r\n  useGsap(\r\n    root,\r\n    () => {\r\n      if (prefersReduced()) return\r\n      gsap\r\n        .timeline({\r\n          scrollTrigger: { trigger: root.current, start: 'top top', end: 'bottom bottom', scrub: 0.6 },\r\n          defaults: { ease: 'none' },\r\n        })\r\n        .to('.hero-cam', { scale: desktop ? 1.38 : 1.22, transformOrigin: desktop ? '84% 18%' : '70% 20%' }, 0)\r\n        .to('.hero-copy', { yPercent: -22, opacity: 0, duration: 0.55 }, 0)\r\n        .to('.hero-shade', { opacity: 0.82, duration: 0.5 }, 0.5)\r\n    },\r\n    [desktop],\r\n  )\r\n\r\n  return (\r\n    <section ref={root} className=\"scrolly\" style={{ ['--scrolly-h' as string]: '175vh' }} aria-label=\"Creative Mind\">\r\n      <div className=\"scrolly-pin\">\r\n        {/* Environment */}\r\n        <div className=\"hero-media absolute inset-x-0 bottom-0 h-[66svh] lg:inset-0 lg:h-auto\">\r\n          <div className=\"hero-cam h-full w-full will-change-transform\">\r\n            {/* <video\r\n              className=\"h-full w-full object-cover object-[61%_50%] lg:object-[70%_50%]\"\r\n              autoPlay\r\n              muted\r\n              loop\r\n              playsInline\r\n              preload=\"metadata\"\r\n              poster=\"/media/hero-poster.jpg\"\r\n              aria-label={tr(ui.hero.alt)}\r\n            > */}\r\n              <source src=\"/media/hero.webm\" type=\"video/webm\" />\r\n              <source src={desktop ? '/media/hero-1080.mp4' : '/media/hero-720.mp4'} type=\"video/mp4\" />\r\n            </video>\r\n          </div>\r\n        </div>\r\n        {/* Navy grading keeps the brand colour dominant and clears space for the headline. */}\r\n        <div className=\"pointer-events-none absolute inset-0 bg-navy/25 mix-blend-multiply\" />\r\n        <div className=\"pointer-events-none absolute inset-0 bg-gradient-to-b from-navy from-[30%] via-navy/55 via-[50%] to-transparent to-[72%] lg:hidden\" />\r\n        <div className=\"pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-navy/95 via-navy/55 via-[38%] to-transparent to-[62%] lg:block\" />\r\n        <div className=\"pointer-events-none absolute inset-x-0 bottom-0 h-[32%] bg-gradient-to-t from-navy via-navy/60 to-transparent\" />\r\n        <div className=\"pointer-events-none absolute inset-x-0 top-0 hidden h-40 bg-gradient-to-b from-navy/80 to-transparent lg:block\" />\r\n        <div className=\"hero-shade pointer-events-none absolute inset-0 bg-navy opacity-0\" />\r\n\r\n        {/* Copy sits in the left half in both languages; Arabic aligns toward the figure. */}\r\n        <div className=\"hero-copy wrap relative flex h-full flex-col justify-between pt-28 pb-8 lg:justify-end lg:pt-0 lg:pb-[7vh]\" dir=\"ltr\">\r\n          <div className={lang === 'ar' ? 'lg:max-w-[46%]' : 'lg:max-w-[54%]'} dir={lang === 'ar' ? 'rtl' : 'ltr'}>\r\n            <p className=\"hero-fade eyebrow mb-5 flex items-center gap-3 text-white/80 lg:mb-7\">\r\n              <span className=\"sphere block h-2 w-2\" aria-hidden=\"true\" />\r\n              {tr(ui.hero.kicker)}\r\n            </p>\r\n            <h1 className=\"t-hero\">\r\n              {lines.map((l, i) => (\r\n                <span className=\"line-mask\" key={i}>\r\n                  <span className={`hero-line line-inner ${i === 1 ? 'thin' : ''}`}>\r\n                    {i === 2 ? (\r\n                      <>\r\n                        {l.slice(0, -1)}\r\n                        <span className=\"text-signal\">{l.slice(-1)}</span>\r\n                      </>\r\n                    ) : (\r\n                      l\r\n                    )}\r\n                  </span>\r\n                </span>\r\n              ))}\r\n            </h1>\r\n            <p className=\"hero-fade t-lead mt-6 max-w-[34ch] text-white/85 lg:mt-8\">{tr(ui.hero.sub)}</p>\r\n            <div className=\"hero-fade mt-8 hidden flex-wrap gap-3 lg:flex\">\r\n              <Cta to=\"/contact\">{tr(ui.cta)}</Cta>\r\n              <Cta to=\"/work\" variant=\"ghost\">\r\n                {tr(ui.explore)}\r\n              </Cta>\r\n            </div>\r\n          </div>\r\n          <div className=\"hero-fade flex flex-col gap-3 lg:hidden\" dir={lang === 'ar' ? 'rtl' : 'ltr'}>\r\n            <Cta to=\"/contact\" className=\"justify-between\">\r\n              {tr(ui.cta)}\r\n            </Cta>\r\n            <Cta to=\"/work\" variant=\"ghost\" className=\"justify-between bg-navy/50 backdrop-blur-sm\">\r\n              {tr(ui.explore)}\r\n            </Cta>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"hero-fade pointer-events-none absolute end-[clamp(1.25rem,5vw,5.5rem)] bottom-[7vh] hidden items-center gap-3 lg:flex\" aria-hidden=\"true\">\r\n          <span className=\"eyebrow text-white/70\">{tr(ui.scroll)}</span>\r\n          <span className=\"relative block h-12 w-px overflow-hidden bg-white/25\">\r\n            <span className=\"absolute inset-x-0 top-0 h-1/2 animate-[scrollcue_2.2s_cubic-bezier(.16,1,.3,1)_infinite] bg-signal\" />\r\n          </span>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  )\r\n}\r\n"
        }
    ]
}